# Copy to .env and fill in. The app runs WITHOUT a key (stub mode); the key adds
# live question generation, the misconception diagnoser and the narrated report.

# YOUR OpenAI API key. Goes here and nowhere else: never in code, a commit or a
# screenshot. .env is git-ignored.
OPENAI_API_KEY=PASTE_YOUR_OPENAI_KEY_HERE

# Pin an exact model id, never an alias, so a re-run behaves like the demo.
# Verify it exists on your key with:  python -m syllabusmind doctor
SYLLABUS_MODEL=gpt-4o-mini
# Used when the primary is rate-limited or unavailable (may be the same id).
SYLLABUS_FALLBACK_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Retrieval: "keyword" needs nothing installed; "vector" uses the spine's
# sqlite-vec + fastembed search (present in the Codespaces image).
SYLLABUS_RETRIEVER=keyword

# The fences (from the spine). Lower them freely; raise them deliberately.
SLICE_MAX_TOKENS=1200
SLICE_MAX_TOKENS_PER_RUN=250000
SLICE_MAX_ATTEMPTS_PER_STEP=3
SLICE_EXPERT_TIMEOUT_MINUTES=45

# Where runs are stored.
SYLLABUS_DB=run.db
